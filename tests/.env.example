# Copy to tests/.env before running the integration suite.
# These are DDEV's standard defaults and work as-is with `ddev start`.
#
# WARNING: the integration suite drops every table in this database.
# Only ever point it at a throwaway one.

CRAFT_DB_DSN="mysql:host=db;port=3306;dbname=db"
CRAFT_DB_USER="db"
CRAFT_DB_PASSWORD="db"
CRAFT_DB_TABLE_PREFIX=""

SECURITY_KEY="lightning-test-security-key"
