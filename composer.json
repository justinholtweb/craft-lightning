{
  "name": "justinholtweb/craft-lightning",
  "description": "Google PageSpeed Insights integration for Craft CMS — dashboard widget and entry-level performance auditing with Core Web Vitals metrics and optimization suggestions.",
  "type": "craft-plugin",
  "license": "proprietary",
  "version": "5.0.2",
  "keywords": [
    "cms",
    "craftcms",
    "craft-plugin",
    "pagespeed",
    "lighthouse",
    "core web vitals",
    "performance",
    "seo",
    "yii2"
  ],
  "authors": [
    {
      "name": "Justin Holt",
      "homepage": "https://justinholt.com"
    }
  ],
  "support": {
    "email": "justin@justinholt.com",
    "issues": "https://github.com/justinholtweb/craft-lightning/issues?state=open",
    "docs": "https://craft-lightning.com/docs"
  },
  "require": {
    "php": "^8.2",
    "craftcms/cms": "^5.3.0"
  },
  "require-dev": {
    "codeception/codeception": "^5.2.0",
    "codeception/lib-innerbrowser": "4.0.1",
    "codeception/module-asserts": "^3.0.0",
    "codeception/module-datafactory": "^3.0.0",
    "codeception/module-phpbrowser": "^3.0.0",
    "codeception/module-rest": "^3.3.2",
    "codeception/module-yii2": "^1.1.9",
    "craftcms/ecs": "dev-main",
    "craftcms/phpstan": "dev-main",
    "fakerphp/faker": "^1.19.0",
    "league/factory-muffin": "^3.3.0",
    "phpunit/phpunit": "^10.5",
    "vlucas/phpdotenv": "^5.4.1"
  },
  "autoload": {
    "psr-4": {
      "justinholtweb\\lightning\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "justinholtweb\\lightning\\tests\\": "tests/"
    }
  },
  "scripts": {
    "test": [
      "@test:unit",
      "@test:integration"
    ],
    "test:unit": "phpunit",
    "test:integration": "codecept run integration",
    "phpstan": "phpstan --memory-limit=1G",
    "check-cs": "ecs check --ansi",
    "fix-cs": "ecs check --ansi --fix"
  },
  "config": {
    "sort-packages": true,
    "platform": {
      "php": "8.2"
    },
    "allow-plugins": {
      "yiisoft/yii2-composer": true,
      "craftcms/plugin-installer": true
    }
  },
  "extra": {
    "name": "Lightning",
    "handle": "lightning",
    "hasCpSettings": true,
    "hasCpSection": false,
    "class": "justinholtweb\\lightning\\Plugin",
    "developer": "Justin Holt",
    "developerUrl": "https://justinholt.com",
    "documentationUrl": "https://craft-lightning.com/docs",
    "description": "Google PageSpeed Insights integration with CWV metrics and optimization suggestions."
  }
}
